# Secrets — never commit the API key
.env
*.key

# Generated / runtime
outputs/
logs/
knowledge_base/decks/*.json
knowledge_base/manifest.json
knowledge_base/sync_state.json
knowledge_base/course_structure.json
knowledge_base/_tmp_export.pptx
knowledge_base/learned_rules.json
knowledge_base/learned_rules.json.bak
knowledge_base/regen_events.json
# The SQLite tracking DB holds real users, runs, teams and per-run cost — runtime data,
# not source. It was tracked by accident: committing it publishes usage data and makes
# every generation dirty the working tree. db.init() recreates the schema on a fresh
# instance, and in production TURSO_* moves the data to the cloud DB anyway.
knowledge_base/tr_app.db
knowledge_base/tr_app.db-wal
knowledge_base/tr_app.db-shm
__pycache__/
*.pyc

# Frontend installed deps — never commit
frontend/node_modules/
# NOTE: frontend/dist/ IS committed on purpose. Render's Python build does not run
# a Node build, so the server serves this pre-built output. Rebuild it whenever the
# frontend source changes:  cd frontend && npm run build   (then commit the result).

# Theme-screenshot artefacts (npm run test:shots) — regenerated on demand, and the
# PNGs are a few hundred kB each. The DOM dump is a snapshot of the jsdom harness.
frontend/test/shots/
frontend/test/_shot.*.html
frontend/test/_app.bundle.mjs
